---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'input'> {
  label: string;
  id: string;
  hint?: string;
  hideLabel?: boolean;
}

const { label, id, hint, hideLabel = false, class: className, ...rest } = Astro.props;
---

<div class:list={['flex flex-col gap-2', className]}>
  <label for={id} class:list={['label', { 'sr-only': hideLabel }]}>{label}</label>
  <input
    id={id}
    aria-describedby={hint ? `${id}-hint` : undefined}
    class="w-full border-0 border-b border-line-strong bg-transparent px-0 py-2.5 font-mono text-sm text-ink placeholder:text-faint focus:border-accent focus:ring-0 focus:outline-none disabled:opacity-40 aria-[invalid=true]:border-bad"
    {...rest}
  />
  {hint && <p id={`${id}-hint`} class="font-mono text-[11px] text-faint">{hint}</p>}
</div>

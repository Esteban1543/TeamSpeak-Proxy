---
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
---

<section class="panel">
  <div class="flex items-center justify-between gap-2 px-6 py-5">
    <h2 class="label">Redirecciones</h2>
    <span id="redirect-count" class="font-mono text-[11px] text-faint"></span>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full min-w-[66rem] text-left text-sm">
      <thead>
        <tr class="border-y border-line">
          <th scope="col" class="label w-64 px-6 py-3 font-normal text-faint">Alias</th>
          <th scope="col" class="label px-6 py-3 font-normal text-faint">Destino</th>
          <th scope="col" class="label px-6 py-3 font-normal text-faint">Resuelto</th>
          <th scope="col" class="label px-6 py-3 font-normal text-faint">Dirección pública</th>
          <th scope="col" class="label px-6 py-3 font-normal text-faint">Estado</th>
          <th scope="col" class="label px-6 py-3 font-normal text-faint">Tráfico</th>
          <th scope="col" class="label px-6 py-3 font-normal text-faint">Creada</th>
          <th scope="col" class="px-6 py-3"><span class="sr-only">Acciones</span></th>
        </tr>
      </thead>
      <tbody id="redirect-rows" class="divide-y divide-line"></tbody>
    </table>
  </div>

  <p id="redirect-empty" class="label px-6 py-14 text-center text-faint" hidden>
    // sin redirecciones activas
  </p>
  <p id="redirect-loading" class="label animate-pulse px-6 py-14 text-center text-faint">Cargando_</p>

  <template id="redirect-row-template">
    <tr class="group align-top transition-colors hover:bg-accent/[0.03]">
      <td class="w-64 px-6 py-4">
        <div data-alias="view" class="flex items-center gap-2">
          <span data-field="alias" class="font-medium break-all text-ink"></span>
          <button
            type="button"
            data-action="edit-alias"
            class="shrink-0 px-1 text-dim opacity-50 transition group-hover:opacity-100 hover:text-accent focus-visible:opacity-100"
            title="Editar alias"
            aria-label="Editar alias"
          >
            ✎
          </button>
        </div>
        <form data-alias="edit" class="flex items-center gap-1" novalidate hidden>
          <input
            data-field="alias-input"
            aria-label="Alias"
            maxlength="60"
            autocomplete="off"
            class="w-full min-w-0 flex-1 border-0 border-b border-accent bg-transparent px-0 py-1 text-sm text-ink focus:ring-0 focus:outline-none disabled:opacity-40"
          />
          <button type="submit" class="shrink-0 px-1.5 text-ok hover:[text-shadow:0_0_10px_#34f5a4]" title="Guardar" aria-label="Guardar alias">✓</button>
          <button type="button" data-action="cancel-alias" class="shrink-0 px-1.5 text-faint hover:text-ink" title="Cancelar" aria-label="Cancelar">✕</button>
        </form>
      </td>
      <td class="px-6 py-4">
        <div data-field="target" class="break-all text-ink"></div>
        <div data-field="kind" class="mt-0.5 font-mono text-[10px] tracking-[0.2em] text-faint uppercase"></div>
      </td>
      <td class="px-6 py-4 font-mono text-xs text-dim">
        <div data-field="resolved"></div>
        <div data-field="resolved-at" class="mt-0.5 text-[10px] text-faint"></div>
      </td>
      <td class="px-6 py-4">
        <button
          type="button"
          data-action="copy"
          class="font-mono text-accent transition-[text-shadow] hover:[text-shadow:0_0_12px_#22e1ff99]"
          title="Copiar"
        >
          <span data-field="public"></span>
        </button>
      </td>
      <td class="px-6 py-4">
        <Badge />
        <div data-field="error" class="mt-1 max-w-56 font-mono text-[11px] text-bad/80"></div>
      </td>
      <td class="px-6 py-4 font-mono text-xs whitespace-nowrap text-dim">
        <div data-field="clients"></div>
        <div data-field="bytes" class="mt-0.5 text-[10px] text-faint"></div>
      </td>
      <td data-field="created" class="px-6 py-4 font-mono text-xs whitespace-nowrap text-faint"></td>
      <td class="px-6 py-4 text-right whitespace-nowrap">
        <div data-confirm="idle" class="opacity-40 transition-opacity group-hover:opacity-100 group-focus-within:opacity-100">
          <Button variant="danger" size="sm" data-action="ask-delete">Eliminar</Button>
        </div>
        <div data-confirm="ask" class="flex items-center justify-end gap-1" hidden>
          <span class="label mr-1 text-bad">¿Eliminar?</span>
          <Button variant="danger" size="sm" data-action="confirm-delete" class="text-bad">Sí</Button>
          <Button variant="ghost" size="sm" data-action="cancel-delete">No</Button>
        </div>
      </td>
    </tr>
  </template>
</section>

<script>
  import { formatBytes, formatDate } from '../../lib/format';
  import {
    $lastUpdated,
    $loaded,
    $redirects,
    errorMessage,
    removeRedirect,
    renameRedirect,
    toast,
  } from '../../lib/store';
  import type { Redirect } from '../../types/redirect';

  const STATUS_LABELS: Record<Redirect['status'], string> = {
    active: 'Activa',
    pending: 'Pendiente',
    error: 'Error',
    stopped: 'Detenida',
  };

  const tbody = document.getElementById('redirect-rows')!;
  const empty = document.getElementById('redirect-empty')!;
  const loading = document.getElementById('redirect-loading')!;
  const count = document.getElementById('redirect-count')!;
  const template = document.getElementById('redirect-row-template') as HTMLTemplateElement;

  // Estado de la UI que debe sobrevivir a los refrescos periódicos.
  const confirming = new Set<number>();
  const deleting = new Set<number>();
  // Mientras se edita un alias no se reconstruyen las filas (se perdería lo escrito).
  let editingId: number | null = null;

  function field(row: Element, name: string): HTMLElement {
    return row.querySelector<HTMLElement>(`[data-field="${name}"]`)!;
  }

  function renderRow(r: Redirect): HTMLTableRowElement {
    const row = (template.content.firstElementChild as HTMLTableRowElement).cloneNode(true) as HTMLTableRowElement;
    row.dataset['id'] = String(r.id);
    const alias = field(row, 'alias');
    alias.textContent = r.alias || 'sin alias';
    alias.classList.toggle('text-faint', !r.alias);
    alias.classList.toggle('italic', !r.alias);
    alias.classList.toggle('font-normal', !r.alias);
    row.dataset['alias'] = r.alias;
    field(row, 'target').textContent = r.target;
    field(row, 'kind').textContent = r.is_domain ? 'Dominio' : 'IP';
    field(row, 'resolved').textContent = r.resolved_address;
    field(row, 'resolved-at').textContent = r.resolved_at ? `Resuelto ${formatDate(r.resolved_at)}` : '';
    field(row, 'public').textContent = r.public_address;

    const badge = row.querySelector<HTMLElement>('.badge')!;
    badge.dataset['status'] = r.status;
    badge.querySelector('[data-badge-label]')!.textContent = STATUS_LABELS[r.status] ?? r.status;
    field(row, 'error').textContent = r.error ?? '';

    field(row, 'clients').textContent = `${r.clients} ${r.clients === 1 ? 'cliente' : 'clientes'}`;
    field(row, 'bytes').textContent = `↑ ${formatBytes(r.bytes_in)} · ↓ ${formatBytes(r.bytes_out)}`;
    field(row, 'created').textContent = formatDate(r.created_at);

    const asking = confirming.has(r.id);
    row.querySelector<HTMLElement>('[data-confirm="idle"]')!.hidden = asking;
    row.querySelector<HTMLElement>('[data-confirm="ask"]')!.hidden = !asking;
    if (deleting.has(r.id)) {
      row.querySelectorAll('button').forEach((b) => (b.disabled = true));
      row.classList.add('opacity-50');
    }
    return row;
  }

  function renderCount(): void {
    const updated = $lastUpdated.get();
    const time = updated ? ` · act. ${updated.toLocaleTimeString('es-ES')}` : '';
    count.textContent = $loaded.get() ? `${$redirects.get().length} en total${time}` : '';
  }

  function render(): void {
    const redirects = $redirects.get();
    const loaded = $loaded.get();
    loading.hidden = loaded;
    empty.hidden = !loaded || redirects.length > 0;
    renderCount();
    if (editingId !== null) return; // se pinta al terminar de editar
    tbody.replaceChildren(...redirects.map(renderRow));
  }

  function rowById(id: number): HTMLTableRowElement | null {
    return tbody.querySelector<HTMLTableRowElement>(`tr[data-id="${id}"]`);
  }

  function aliasInput(row: Element): HTMLInputElement {
    return row.querySelector<HTMLInputElement>('[data-field="alias-input"]')!;
  }

  function startEdit(row: HTMLTableRowElement, id: number): void {
    if (editingId !== null && editingId !== id) stopEdit();
    editingId = id;
    row.querySelector<HTMLElement>('[data-alias="view"]')!.hidden = true;
    row.querySelector<HTMLElement>('[data-alias="edit"]')!.hidden = false;
    const input = aliasInput(row);
    input.value = row.dataset['alias'] ?? '';
    input.focus();
    input.select();
  }

  function stopEdit(): void {
    editingId = null;
    render();
  }

  async function saveEdit(row: HTMLTableRowElement, id: number): Promise<void> {
    const input = aliasInput(row);
    const alias = input.value.trim();
    if (!alias) {
      toast('El alias no puede quedar vacío', 'error');
      input.focus();
      return;
    }
    if (alias === row.dataset['alias']) {
      stopEdit();
      return;
    }
    const controls = row.querySelectorAll<HTMLInputElement | HTMLButtonElement>('[data-alias="edit"] :is(input, button)');
    controls.forEach((el) => (el.disabled = true));
    try {
      const updated = await renameRedirect(id, alias);
      toast(`Alias actualizado: ${updated.alias}`, 'success', 2500);
      stopEdit();
    } catch (err) {
      toast(errorMessage(err), 'error');
      controls.forEach((el) => (el.disabled = false));
      input.focus();
    }
  }

  tbody.addEventListener('submit', (event) => {
    event.preventDefault();
    const row = (event.target as Element).closest<HTMLTableRowElement>('tr');
    if (row) void saveEdit(row, Number(row.dataset['id']));
  });

  tbody.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && editingId !== null) {
      event.preventDefault();
      const id = editingId;
      stopEdit();
      rowById(id)?.querySelector<HTMLButtonElement>('[data-action="edit-alias"]')?.focus();
    }
  });

  $redirects.subscribe(render);
  $loaded.subscribe(render);
  $lastUpdated.subscribe(renderCount);

  tbody.addEventListener('click', async (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('[data-action]');
    const row = button?.closest<HTMLTableRowElement>('tr');
    if (!button || !row) return;
    const id = Number(row.dataset['id']);

    switch (button.dataset['action']) {
      case 'edit-alias':
        startEdit(row, id);
        break;
      case 'cancel-alias':
        stopEdit();
        break;
      case 'copy': {
        const text = field(row, 'public').textContent ?? '';
        try {
          await navigator.clipboard.writeText(text);
          toast(`Copiado: ${text}`, 'info', 2500);
        } catch {
          toast('No se pudo copiar (el portapapeles requiere HTTPS)', 'error');
        }
        break;
      }
      case 'ask-delete':
        editingId = null;
        confirming.add(id);
        render();
        break;
      case 'cancel-delete':
        confirming.delete(id);
        render();
        break;
      case 'confirm-delete':
        confirming.delete(id);
        deleting.add(id);
        render();
        try {
          await removeRedirect(id);
          toast('Redirección eliminada; el puerto vuelve a estar libre', 'success');
        } catch (err) {
          toast(errorMessage(err), 'error');
        } finally {
          deleting.delete(id);
          render();
        }
        break;
    }
  });
</script>

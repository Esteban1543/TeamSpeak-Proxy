---
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Input from '../ui/Input.astro';
import Modal from '../ui/Modal.astro';
---

<section class="panel">
  <div class="flex items-center justify-between gap-2 px-6 py-5">
    <h2 class="label">Redirecciones</h2>
    <span id="redirect-count" class="font-mono text-[11px] text-faint"></span>
  </div>

  <!-- Todas las celdas en una línea: si no cabe, la tabla se desplaza en horizontal.
       `relative` hace que los elementos sr-only (absolutos) queden dentro del scroll. -->
  <div class="relative overflow-x-auto">
    <table class="w-full text-left text-sm whitespace-nowrap">
      <thead>
        <tr class="border-y border-line">
          <th scope="col" class="label py-3 pr-4 pl-6 font-normal text-faint">Alias</th>
          <th scope="col" class="label px-4 py-3 font-normal text-faint">Destino</th>
          <th scope="col" class="label px-4 py-3 font-normal text-faint">Dirección pública</th>
          <th scope="col" class="label px-4 py-3 font-normal text-faint">Estado</th>
          <th scope="col" class="label px-4 py-3 font-normal text-faint">Tráfico</th>
          <th scope="col" class="label px-4 py-3 font-normal text-faint">Creada</th>
          <th scope="col" class="py-3 pr-6 pl-4"><span class="sr-only">Acciones</span></th>
        </tr>
      </thead>
      <tbody id="redirect-rows" class="divide-y divide-line"></tbody>
    </table>
  </div>

  <p id="redirect-empty" class="label px-6 py-14 text-center text-faint" hidden>
    // sin redirecciones activas
  </p>
  <p id="redirect-loading" class="label animate-pulse px-6 py-14 text-center text-faint">Cargando_</p>

  <template id="redirect-row-template">
    <tr class="group align-top transition-colors hover:bg-accent/[0.03]">
      <td class="py-4 pr-4 pl-6">
        <div class="flex min-w-[8rem] items-center gap-2">
          <span data-field="alias" class="max-w-[13rem] truncate font-medium text-ink"></span>
          <button
            type="button"
            data-action="edit-alias"
            class="shrink-0 px-1 text-dim opacity-60 transition group-hover:opacity-100 hover:text-accent focus-visible:opacity-100"
            title="Editar alias"
            aria-label="Editar alias"
          >
            ✎
          </button>
        </div>
      </td>
      <td class="px-4 py-4">
        <div data-field="target" class="max-w-[12rem] truncate text-ink"></div>
        <div data-field="kind" class="mt-0.5 font-mono text-[10px] tracking-[0.2em] text-faint uppercase"></div>
      </td>
      <td class="px-4 py-4">
        <button
          type="button"
          data-action="copy"
          class="font-mono text-accent transition-[text-shadow] hover:[text-shadow:0_0_12px_#22e1ff99]"
          title="Copiar"
        >
          <span data-field="public"></span>
        </button>
      </td>
      <td class="px-4 py-4">
        <Badge />
        <div data-field="error" class="mt-1 max-w-56 truncate font-mono text-[11px] text-bad/80"></div>
      </td>
      <td class="px-4 py-4 font-mono text-xs text-dim">
        <div data-field="clients"></div>
        <div data-field="bytes" class="mt-0.5 text-[10px] text-faint"></div>
      </td>
      <td data-field="created" class="px-4 py-4 font-mono text-xs text-faint"></td>
      <td class="py-4 pr-6 pl-4 text-right">
        <div data-confirm="idle" class="opacity-40 transition-opacity group-hover:opacity-100 group-focus-within:opacity-100">
          <Button variant="danger" size="sm" data-action="ask-delete">Eliminar</Button>
        </div>
        <div data-confirm="ask" class="flex items-center justify-end gap-1" hidden>
          <span class="label mr-1 text-bad">¿Eliminar?</span>
          <Button variant="danger" size="sm" data-action="confirm-delete" class="text-bad">Sí</Button>
          <Button variant="ghost" size="sm" data-action="cancel-delete">No</Button>
        </div>
      </td>
    </tr>
  </template>
</section>

<Modal id="alias-dialog" title="Editar alias">
  <p id="alias-dialog-context" class="mt-3 font-mono text-xs break-all text-faint"></p>
  <form id="alias-form" class="mt-6 space-y-6" novalidate>
    <Input
      id="alias-dialog-input"
      name="alias"
      label="Alias"
      hint="Máximo 60 caracteres"
      autocomplete="off"
      required
      maxlength={60}
    />
    <p id="alias-dialog-error" class="font-mono text-xs text-bad" role="alert" hidden></p>
    <div class="flex justify-end gap-3">
      <Button id="alias-dialog-cancel" variant="ghost">Cancelar</Button>
      <Button id="alias-dialog-save" type="submit">Guardar</Button>
    </div>
  </form>
</Modal>

<script>
  import { formatBytes, formatDate } from '../../lib/format';
  import {
    $lastUpdated,
    $loaded,
    $redirects,
    errorMessage,
    removeRedirect,
    renameRedirect,
    toast,
  } from '../../lib/store';
  import type { Redirect } from '../../types/redirect';

  const STATUS_LABELS: Record<Redirect['status'], string> = {
    active: 'Activa',
    pending: 'Pendiente',
    error: 'Error',
    stopped: 'Detenida',
  };

  const tbody = document.getElementById('redirect-rows')!;
  const empty = document.getElementById('redirect-empty')!;
  const loading = document.getElementById('redirect-loading')!;
  const count = document.getElementById('redirect-count')!;
  const template = document.getElementById('redirect-row-template') as HTMLTemplateElement;

  // Estado de la UI que debe sobrevivir a los refrescos periódicos.
  const confirming = new Set<number>();
  const deleting = new Set<number>();

  function field(row: Element, name: string): HTMLElement {
    return row.querySelector<HTMLElement>(`[data-field="${name}"]`)!;
  }

  function renderRow(r: Redirect): HTMLTableRowElement {
    const row = (template.content.firstElementChild as HTMLTableRowElement).cloneNode(true) as HTMLTableRowElement;
    row.dataset['id'] = String(r.id);

    const alias = field(row, 'alias');
    alias.textContent = r.alias || 'sin alias';
    alias.title = r.alias;
    alias.classList.toggle('text-faint', !r.alias);
    alias.classList.toggle('italic', !r.alias);
    alias.classList.toggle('font-normal', !r.alias);

    const target = field(row, 'target');
    target.textContent = r.target;
    target.title = r.target;
    // Para dominios, la IP a la que resolvió (con la fecha en el tooltip); para IPs sería repetir.
    const kind = field(row, 'kind');
    kind.textContent = r.is_domain ? 'Dominio' : 'IP';
    if (r.is_domain) {
      const resolved = document.createElement('span');
      resolved.className = 'tracking-normal text-dim';
      resolved.textContent = ` → ${r.resolved_address}`;
      kind.append(resolved);
    }
    kind.title = r.resolved_at ? `Resuelto ${formatDate(r.resolved_at)}` : '';
    field(row, 'public').textContent = r.public_address;

    const badge = row.querySelector<HTMLElement>('.badge')!;
    badge.dataset['status'] = r.status;
    badge.querySelector('[data-badge-label]')!.textContent = STATUS_LABELS[r.status] ?? r.status;
    const error = field(row, 'error');
    error.textContent = r.error ?? '';
    error.title = r.error ?? '';

    field(row, 'clients').textContent = `${r.clients} ${r.clients === 1 ? 'cliente' : 'clientes'}`;
    field(row, 'bytes').textContent = `↑ ${formatBytes(r.bytes_in)} · ↓ ${formatBytes(r.bytes_out)}`;
    field(row, 'created').textContent = formatDate(r.created_at);

    const asking = confirming.has(r.id);
    row.querySelector<HTMLElement>('[data-confirm="idle"]')!.hidden = asking;
    row.querySelector<HTMLElement>('[data-confirm="ask"]')!.hidden = !asking;
    if (deleting.has(r.id)) {
      row.querySelectorAll('button').forEach((b) => (b.disabled = true));
      row.classList.add('opacity-50');
    }
    return row;
  }

  function renderCount(): void {
    const updated = $lastUpdated.get();
    const time = updated ? ` · act. ${updated.toLocaleTimeString('es-ES')}` : '';
    count.textContent = $loaded.get() ? `${$redirects.get().length} en total${time}` : '';
  }

  function render(): void {
    const redirects = $redirects.get();
    const loaded = $loaded.get();
    loading.hidden = loaded;
    empty.hidden = !loaded || redirects.length > 0;
    renderCount();

    // Repintar sin perder el foco del teclado si estaba en un botón de la tabla.
    const active = document.activeElement;
    const focus =
      active instanceof HTMLElement && tbody.contains(active)
        ? { id: active.closest('tr')?.dataset['id'], action: active.dataset['action'] }
        : null;
    tbody.replaceChildren(...redirects.map(renderRow));
    if (focus?.id && focus.action) {
      tbody.querySelector<HTMLElement>(`tr[data-id="${focus.id}"] [data-action="${focus.action}"]`)?.focus();
    }
  }

  $redirects.subscribe(render);
  $loaded.subscribe(render);
  $lastUpdated.subscribe(renderCount);

  // --- Modal de edición del alias (fuera de la tabla: los refrescos no le afectan)
  const dialog = document.getElementById('alias-dialog') as HTMLDialogElement;
  const aliasForm = document.getElementById('alias-form') as HTMLFormElement;
  const aliasInput = document.getElementById('alias-dialog-input') as HTMLInputElement;
  const aliasContext = document.getElementById('alias-dialog-context')!;
  const aliasError = document.getElementById('alias-dialog-error')!;
  const aliasSave = document.getElementById('alias-dialog-save') as HTMLButtonElement;
  let editing: Redirect | null = null;

  function setAliasError(message: string | null): void {
    aliasError.textContent = message ?? '';
    aliasError.hidden = !message;
    aliasInput.setAttribute('aria-invalid', message ? 'true' : 'false');
  }

  function setSaving(saving: boolean): void {
    aliasInput.disabled = saving;
    aliasSave.disabled = saving;
    aliasSave.textContent = saving ? 'Guardando_' : 'Guardar';
  }

  function openAliasDialog(id: number): void {
    const redirect = $redirects.get().find((r) => r.id === id);
    if (!redirect) return;
    editing = redirect;
    aliasContext.textContent = `${redirect.target} → ${redirect.public_address}`;
    aliasInput.value = redirect.alias;
    setAliasError(null);
    setSaving(false);
    dialog.showModal();
    aliasInput.focus();
    aliasInput.select();
  }

  aliasForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!editing) return;
    const alias = aliasInput.value.trim();
    if (!alias) {
      setAliasError('El alias no puede quedar vacío.');
      aliasInput.focus();
      return;
    }
    if (alias === editing.alias) {
      dialog.close();
      return;
    }
    setSaving(true);
    try {
      const updated = await renameRedirect(editing.id, alias);
      dialog.close();
      toast(`Alias actualizado: ${updated.alias}`, 'success', 2500);
    } catch (err) {
      setSaving(false);
      setAliasError(errorMessage(err));
      aliasInput.focus();
    }
  });

  document.getElementById('alias-dialog-cancel')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => {
    // Devolver el foco al ✎ de la fila editada (la fila puede haberse repintado).
    const id = editing?.id;
    editing = null;
    if (id !== undefined) {
      tbody.querySelector<HTMLButtonElement>(`tr[data-id="${id}"] [data-action="edit-alias"]`)?.focus();
    }
  });

  // --- Acciones de las filas
  tbody.addEventListener('click', async (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('[data-action]');
    const row = button?.closest<HTMLTableRowElement>('tr');
    if (!button || !row) return;
    const id = Number(row.dataset['id']);

    switch (button.dataset['action']) {
      case 'edit-alias':
        openAliasDialog(id);
        break;
      case 'copy': {
        const text = field(row, 'public').textContent ?? '';
        try {
          await navigator.clipboard.writeText(text);
          toast(`Copiado: ${text}`, 'info', 2500);
        } catch {
          toast('No se pudo copiar (el portapapeles requiere HTTPS)', 'error');
        }
        break;
      }
      case 'ask-delete':
        confirming.add(id);
        render();
        break;
      case 'cancel-delete':
        confirming.delete(id);
        render();
        break;
      case 'confirm-delete':
        confirming.delete(id);
        deleting.add(id);
        render();
        try {
          await removeRedirect(id);
          toast('Redirección eliminada; el puerto vuelve a estar libre', 'success');
        } catch (err) {
          toast(errorMessage(err), 'error');
        } finally {
          deleting.delete(id);
          render();
        }
        break;
    }
  });
</script>

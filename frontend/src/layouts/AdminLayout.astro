---
import BaseLayout from './BaseLayout.astro';
import Button from '../components/ui/Button.astro';

interface Props {
  title: string;
}

const appName = import.meta.env.PUBLIC_APP_NAME ?? 'TS3 Proxy Panel';
const { title } = Astro.props;
---

<BaseLayout title={title}>
  <div id="session-loading" class="flex min-h-dvh items-center justify-center">
    <span class="label animate-pulse">Verificando sesión_</span>
  </div>

  <div id="admin-shell" hidden>
    <header class="border-b border-line">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6">
        <a href="/" class="flex items-center gap-3">
          <span class="h-2 w-2 rounded-full bg-accent glow"></span>
          <span class="font-mono text-sm tracking-[0.25em] text-ink uppercase">{appName}</span>
        </a>
        <div class="flex items-center gap-5">
          <span class="label hidden sm:inline">
            <span class="text-faint">usr://</span><span id="current-user" class="text-ink"></span>
          </span>
          <Button id="logout-button" variant="ghost" size="sm">Salir ⏻</Button>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-6xl space-y-6 px-4 py-10 sm:px-6">
      <slot />
    </main>
  </div>
</BaseLayout>

<script>
  import { logout } from '../lib/api/auth';
  import { requireSession } from '../lib/guard';
  import { errorMessage, toast } from '../lib/store';

  const loading = document.getElementById('session-loading')!;
  const shell = document.getElementById('admin-shell')!;

  requireSession()
    .then((user) => {
      document.getElementById('current-user')!.textContent = user.username;
      loading.hidden = true;
      shell.hidden = false;
      document.dispatchEvent(new CustomEvent('session:ready'));
    })
    .catch((err) => {
      loading.textContent = errorMessage(err);
    });

  document.getElementById('logout-button')!.addEventListener('click', async () => {
    try {
      await logout();
    } catch (err) {
      toast(errorMessage(err), 'error');
      return;
    }
    location.replace('/login');
  });
</script>

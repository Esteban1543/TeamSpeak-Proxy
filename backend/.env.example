# Dirección donde escucha la API. Con network_mode: host, déjalo en 127.0.0.1
# para que solo Caddy pueda acceder a ella.
API_HOST=127.0.0.1
API_PORT=8000

# Ruta de la base de datos SQLite (dentro del contenedor; ./data en el host).
DATABASE_PATH=/data/proxy.db

# Rango de puertos UDP que puede usar el panel (ambos incluidos).
# Ábrelo en el firewall: ufw allow 10000:10100/udp
PORT_RANGE_START=10000
PORT_RANGE_END=10100

# IP pública (o dominio) de la VPS que verán los usuarios: PUBLIC_HOST:puerto
PUBLIC_HOST=123.45.67.89

# Credenciales del administrador.
# Genera ambos valores con: docker compose run --rm backend python -m app.hash_password
# El hash va entre comillas simples porque contiene '$'.
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
SESSION_EXPIRE_HOURS=12

# true si el panel se sirve por HTTPS (recomendado). Pon false solo si accedes
# por http://IP, o el navegador no enviará la cookie de sesión.
SESSION_COOKIE_SECURE=true

# Cada cuántos minutos se vuelven a resolver los dominios.
DNS_REFRESH_MINUTES=10

# Motor de reenvío: asyncio (actual). nftables está reservado para el futuro.
FORWARDING_ENGINE=asyncio

# Segundos sin tráfico tras los que se cierra la sesión UDP de un cliente.
CLIENT_IDLE_TIMEOUT=120
